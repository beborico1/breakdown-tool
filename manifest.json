{
  "manifest_version": 3,
  "name": "会議 kaigi meeting",
  "version": "1.1.0",
  "description": "Extract and copy captions from Google Meet with translation support",
  "permissions": [
    "clipboardWrite",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "会議 kaigi meeting",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://chat.google.com/*",
        "https://mail.google.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "all_frames": true
    }
  ]
}
