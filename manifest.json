{
  "manifest_version": 3,
  "name": "会議 kaigi meeting",
  "version": "1.2.0",
  "description": "Extract and copy captions from Google Meet with translation support",
  "permissions": [
    "clipboardWrite",
    "activeTab",
    "storage",
    "scripting",
    "offscreen"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/kuromoji-dict/*",
        "assets/jmdict/*",
        "src/offscreen/offscreen.html",
        "dist/offscreen.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*"
  ],
  "optional_host_permissions": [
    "http://localhost:8765/*",
    "https://*/*"
  ],
  "icons": {
    "16": "assets/icons/icon16.png",
    "32": "assets/icons/icon32.png",
    "48": "assets/icons/icon48.png",
    "128": "assets/icons/icon128.png"
  },
  "background": {
    "service_worker": "dist/service-worker.js"
  },
  "action": {
    "default_popup": "src/pages/popup/popup.html",
    "default_title": "会議 kaigi meeting",
    "default_icon": {
      "16": "assets/icons/icon16.png",
      "32": "assets/icons/icon32.png",
      "48": "assets/icons/icon48.png",
      "128": "assets/icons/icon128.png"
    }
  },
  "commands": {
    "translate-to-japanese": {
      "suggested_key": { "default": "Alt+J", "mac": "Alt+J" },
      "description": "Translate selected text to Japanese (append to input)"
    },
    "translate-to-japanese-replace": {
      "suggested_key": { "default": "Alt+R", "mac": "Alt+R" },
      "description": "Replace selected text with its Japanese translation"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*",
        "https://chat.google.com/*",
        "https://mail.google.com/*"
      ],
      "js": ["dist/content.js"],
      "css": ["src/content/content.css"],
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
